{
  "name": "luna-store",
  "version": "1.3.5",
  "description": "Luna Store - Electron tabanlı uygulama mağazası.",
  "author": "herzane <luna@herzane.tr>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/herzane52/luna-store-electron.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "tr.herzane.luna",
    "productName": "Luna Store",
    "directories": {
      "output": "build/dist"
    },
    "linux": {
      "target": [
        "pacman",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "electron/assets/luna.png"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "libxcb",
        "at-spi2-atk",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "mesa",
        "libdrm",
        "libxkbcommon"
      ]
    },
    "files": [
      "build/out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "herzane52",
        "repo": "luna-store-electron"
      }
    ]
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "framer-motion": "^12.23.12",
    "freedesktop-icons": "^1.0.0",
    "lucide-react": "^0.542.0",
    "next": "15.5.0",
    "node-pty": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^38.2.2",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}